{
  "name": "cmd-proving",
  "version": "0.1.0",
  "title": "Command proving",
  "author": "Unibrowser Team",
  "unibrowser_api": "0.1.0",
  "dependencies": {
    "base": ">=0.1.0",
    "toy-markdown": ">=0.1.0"
  },
  "description": "Command system proving mod (CMD-08/09)",
  "capabilities": [
    "commands.capability.provide",
    "document.read.selection",
    "document.edit",
    "ui.command_manager.contribute",
    "ui.toolbar.contribute",
    "ui.toolbar.detach"
  ],
  "contributes": {
    "commands": [
      {
        "id": "cmd-proving.subscript.apply",
        "title": "Apply subscript (proving)",
        "icon": "subscript"
      }
    ],
    "controls": [
      {
        "id": "cmd-proving.control.chip",
        "type": "button",
        "command": "cmd-proving.subscript.apply",
        "label": "Proving chip",
        "icon": "extension",
        "insert": {
          "after": "unibrowser.control.text.subscript"
        }
      }
    ],
    "groups": [
      {
        "id": "cmd-proving.group.proving",
        "label": "Proving",
        "controls": ["cmd-proving.control.chip"]
      }
    ],
    "toolbars": [
      {
        "id": "cmd-proving.detached-markdown",
        "label": "Markdown proving",
        "groups": ["cmd-proving.group.proving"],
        "floatable": true,
        "detachable": true
      }
    ],
    "capability_providers": [
      {
        "id": "cmd-proving::native",
        "families": ["unibrowser.family.text-formatting"],
        "runtime": "native",
        "priority": 10
      }
    ]
  }
}
