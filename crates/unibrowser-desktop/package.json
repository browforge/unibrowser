{
  "name": "unibrowser-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/write-frontend-stamp.mjs",
    "test:overflow": "node --experimental-strip-types --test tests/commandOverflow.test.mjs tests/pdfCmOverflow.test.mjs tests/markdownCmOverflow.test.mjs tests/workshopCmOverflow.test.mjs",
    "test:qa": "node --experimental-strip-types --test tests/catalogInstall.test.mjs tests/pdfHighlightArm.test.mjs tests/workshopCmOverflow.test.mjs",
    "test:new-project": "node --experimental-strip-types --test tests/relationshipLogic.test.mjs tests/templateHubInstall.test.mjs tests/firstSaveDialog.test.mjs tests/newEmptyProject.test.mjs",
    "test:icons": "node --experimental-strip-types --test tests/commandIcons.test.mjs",
    "test:contrast": "node --experimental-strip-types --test tests/shellDensityContrast.test.mjs tests/captureLayoutGuards.test.mjs",
    "test:image-chrome": "node --experimental-strip-types --test tests/imageViewerChrome.test.mjs",
    "test:cm-chrome": "node --experimental-strip-types --test tests/cmCapabilityChrome.test.mjs",
    "test:ui19": "node --experimental-strip-types --test tests/ui19Multiscale.test.mjs",
    "test:chrome": "node --experimental-strip-types --test tests/chromeMetrics.test.mjs",
    "test:capability": "node --experimental-strip-types --test tests/capabilityProvider.test.mjs tests/contentKindTraversal.test.mjs tests/kindHostResolver.test.mjs",
    "test:perm-audit": "node --experimental-strip-types --test tests/permAudit.test.mjs",
    "preview": "vite preview",
    "dev:web": "vite --mode web",
    "prepare:web-public": "node scripts/prepare-web-public.mjs",
    "build:wasm": "bash ../../scripts/build-web-wasm.sh",
    "build:web": "npm run prepare:web-public && npm run build:wasm && tsc && vite build --mode web && cp dist-web/index-web.html dist-web/index.html",
    "test:web-smoke": "playwright test tests/web-smoke.spec.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@monaco-editor/loader": "^1.7.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dxf-parser": "^1.1.2",
    "mammoth": "^1.13.0",
    "marked": "^15.0.12",
    "mermaid": "^11.17.2",
    "monaco-editor": "^0.57.0",
    "monaco-editor-textmate": "^4.0.0",
    "monaco-textmate": "^3.0.1",
    "pdfjs-dist": "^6.4.299",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6",
    "three": "^0.186.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2",
    "@types/three": "^0.186.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
